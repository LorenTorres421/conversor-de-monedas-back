  "components": {
    "schemas": {
      "ConversionForCreation": {
        "required": [
          "amount",
          "fromCurrencyId",
          "toCurrencyId"
        ],
        "type": "object",
        "properties": {
          "fromCurrencyId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "toCurrencyId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CurrencyForCreation": {
        "required": [
          "exchangeRate",
          "isoCode",
          "name",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "type": "string"
          },
          "isoCode": {
            "minLength": 1,
            "type": "string"
          },
          "exchangeRate": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UserForCreation": {
        "required": [
          "email",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserForLogin": {
        "required": [
          "password",
